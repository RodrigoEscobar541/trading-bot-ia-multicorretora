# .env.example — APENAS nomes de variáveis, nunca valores reais (regras.md §10).
# Uso: copiar para `.env` (não versionado) durante o desenvolvimento local.
# Em produção, as chaves ficam no Firebase (CLAUDE.md §7.3).

# Chave da API do Google AI Studio (Gemini)
GEMINI_API_KEY=

# Credenciais da API do Mercado Bitcoin (geradas no painel do MB)
MB_API_TOKEN_ID=
MB_API_TOKEN_SECRET=

# Credenciais OAuth2 da Tastytrade (OAuth Application + Personal OAuth Grant,
# criados em my.tastytrade.com → Manage → API Access → OAuth Applications)
TT_CLIENT_ID=
TT_CLIENT_SECRET=
TT_REFRESH_TOKEN=
# Opcional: número da conta (vazio usa a primeira) e ambiente ('cert' = sandbox)
# TT_ACCOUNT_ID=
# TT_AMBIENTE=cert

# Credenciais da API da Binance (geradas em binance.com → API Management;
# habilitar apenas "Enable Reading" e "Enable Spot & Margin Trading")
BN_API_KEY=
BN_API_SECRET=

# Token gratuito do brapi.dev (dados da B3 — Toro em modo assistido)
BRAPI_TOKEN=

# Bot de AVISOS do Telegram (criado no @BotFather com /newbot). O chat id é o
# número em `chat.id` de https://api.telegram.org/bot<TOKEN>/getUpdates depois
# de você mandar qualquer mensagem para o bot. Em produção, ambos ficam no
# doc global/telegram (configurados pela dashboard).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Caminho para o JSON da service account do Firebase Admin
FIREBASE_SERVICE_ACCOUNT_PATH=

# Alternativa para hospedagem sem arquivos (ex.: Render): o CONTEÚDO do JSON
# da service account, em uma linha. Tem prioridade sobre o caminho acima.
# FIREBASE_SERVICE_ACCOUNT_JSON=

# ID do banco Firestore, se diferente do canônico "(default)"
# FIRESTORE_DATABASE_ID=default

# Opcional (apenas desenvolvimento): "memoria" roda o bot sem Firebase,
# com persistência em memória. Nunca usar em produção.
# BOT_PERSISTENCIA=memoria
